# Credentials are stored in .secrets/oura.json and .secrets/oura-tokens.json.
# Never put real credentials in this example file.
OURA_REDIRECT_URI=http://localhost:8765/oauth/oura/callback

# scripts/setup_mcp.py appends MCP_DATABASE_PASSWORD to local .env; do not set a placeholder here.

# Every launch refreshes this inclusive history window; background sync continues hourly.
SYNC_LOOKBACK_DAYS=90
SYNC_INTERVAL_SECONDS=3600

# Enable only after local Suunto authorization; daily/manual summary collection.
SUUNTO_ENABLED=false
SUUNTO_SYNC_LOOKBACK_DAYS=90
SUUNTO_SYNC_INTERVAL_SECONDS=86400
